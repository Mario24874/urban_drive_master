rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isMember(memberList) {
      return request.auth.uid in memberList;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && isAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    // ── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      // Allow a contact to add themselves when accepting an invitation:
      // only the 'contacts' field may change, and only the caller's own UID
      // may be added (cannot modify any other field or remove existing contacts).
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts'])
        && request.auth.uid in request.resource.data.contacts
        && !(request.auth.uid in resource.data.contacts);
      // Allow a user to remove THEMSELVES from someone else's contacts (mutual unfriend)
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts'])
        && request.auth.uid in resource.data.contacts
        && !(request.auth.uid in request.resource.data.contacts);
    }

    // ── Drivers ─────────────────────────────────────────────────────────────
    match /drivers/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      // Same contact-acceptance rule as users above
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts'])
        && request.auth.uid in request.resource.data.contacts
        && !(request.auth.uid in resource.data.contacts);
      // Allow a user to remove THEMSELVES from someone else's contacts (mutual unfriend)
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts'])
        && request.auth.uid in resource.data.contacts
        && !(request.auth.uid in request.resource.data.contacts);
    }

    // ── Driver locations ────────────────────────────────────────────────────
    match /driver_locations/{driverId} {
      allow read: if isSignedIn();
      allow write: if isOwner(driverId);
    }

    // ── Messages ────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      // Read: any signed-in user. conversationId = sort([uid1,uid2]).join('_')
      // so IDs are non-guessable; this allows queries filtered by conversationId.
      allow read: if isSignedIn();
      // Create: only the actual sender
      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid;
      // Update — receiver: solo acuses de recibo (read/delivered).
      //          sender: solo tombstone de soft-delete (deleted + vaciar contenido).
      allow update: if isSignedIn() && (
        (resource.data.receiverId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'delivered'])) ||
        (resource.data.senderId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'content', 'voiceUrl']) &&
         request.resource.data.deleted == true)
      );
      // Hard delete (limpieza de conversación completa): ambos participantes
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // ── Conversations ───────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.get('participants', [])
      );
    }

    // ── Invitations ─────────────────────────────────────────────────────────
    match /invitations/{invitationId} {
      // Fields written by the app: fromId, toId, toIdentifier (email or phone)
      allow read: if isSignedIn() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.toId   == request.auth.uid ||
        resource.data.toIdentifier == request.auth.token.email
      );
      allow create: if isSignedIn() &&
        request.resource.data.fromId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.toId   == request.auth.uid
      );
      // Both sender and recipient can delete (sender cancels, recipient removes)
      allow delete: if isSignedIn() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.toId   == request.auth.uid
      );
    }

    // ── Admins ──────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      // Only a superadmin may invite (create) or revoke (delete/update) admins,
      // to prevent any admin from granting themselves or others elevated access.
      allow create, update, delete: if isSuperAdmin();
    }

    // ── Companies ───────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isMember(resource.data.adminIds) ||
        isMember(resource.data.memberIds)
      ));
      // Create: a user may only create their OWN company document
      // (doc id == uid) and must set themselves as owner. Prevents creating a
      // company with an arbitrary ownerId or squatting another user's slot.
      allow create: if isSignedIn()
        && companyId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        isMember(resource.data.adminIds) ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
    }

    // ── Subscriptions ───────────────────────────────────────────────────────
    // Document ID == userId (written by Stripe webhook / Cloud Functions)
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || isOwner(subscriptionId);
      // Allow 100% coupon activation from client; all other writes via backend
      allow create: if isOwner(subscriptionId)
        && request.resource.data.paymentMethod == 'coupon'
        && request.resource.data.couponCode != null
        && get(/databases/$(database)/documents/discount_coupons/$(request.resource.data.couponCode)).data.status == 'active'
        && get(/databases/$(database)/documents/discount_coupons/$(request.resource.data.couponCode)).data.type == 'discount_100';
      allow update, delete: if false; // managed exclusively by backend
    }

    // ── FCM Tokens ───────────────────────────────────────────────────────────
    // Document ID == userId — each user has one token doc (web push)
    match /fcm_tokens/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Discount Coupons ─────────────────────────────────────────────────────
    // Document ID is auto-generated; code field is the human-readable token
    match /discount_coupons/{couponId} {
      // Any signed-in user can read (needed for validation at checkout)
      allow read: if isSignedIn();
      // Only admins can create or cancel
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // Admins can update freely; users can only mark as used (after paying)
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.status == 'active'
            && request.resource.data.status == 'used'
            && request.resource.data.usedBy == request.auth.uid);
    }

    // ── Helper: check if user is a company admin or owner ───────────────────
    function isCompanyAdminOrOwner(companyId) {
      let company = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return company.ownerId == request.auth.uid ||
             request.auth.uid in company.get('adminIds', []);
    }

    function isCompanyMember(companyId) {
      let company = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return company.ownerId == request.auth.uid ||
             request.auth.uid in company.get('adminIds', []) ||
             request.auth.uid in company.get('memberIds', []);
    }

    // ── Vehicles ────────────────────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      // Personal vehicles (no companyId) are private; company vehicles readable by members
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.companyId != null && isCompanyMember(resource.data.companyId))
      );
      // Create: only an admin/owner of the target company may add vehicles to it
      // (the app sets companyId on creation). Closes the open create that let any
      // signed-in user insert vehicles into arbitrary companies.
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.companyId != null &&
         isCompanyAdminOrOwner(request.resource.data.companyId))
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.companyId != null && isCompanyAdminOrOwner(resource.data.companyId))
      );
    }

    // ── Company Drivers ──────────────────────────────────────────────────────
    match /company_drivers/{driverId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        (resource.data.companyId != null && isCompanyMember(resource.data.companyId))
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.companyId != null &&
         isCompanyAdminOrOwner(request.resource.data.companyId))
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        (resource.data.companyId != null && isCompanyAdminOrOwner(resource.data.companyId))
      );
    }

    // ── Company Documents ────────────────────────────────────────────────────
    match /company_documents/{documentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.companyId != null && isCompanyMember(resource.data.companyId))
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.companyId != null &&
         isCompanyAdminOrOwner(request.resource.data.companyId))
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.companyId != null && isCompanyAdminOrOwner(resource.data.companyId))
      );
    }

    // ── Vehicle Maintenance ──────────────────────────────────────────────────
    match /vehicle_maintenance/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.companyId != null && isCompanyMember(resource.data.companyId))
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.companyId != null &&
         isCompanyAdminOrOwner(request.resource.data.companyId))
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.companyId != null && isCompanyAdminOrOwner(resource.data.companyId))
      );
    }

    // ── Billing history (invoices) ──────────────────────────────────────────
    match /billingHistory/{invoiceId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.companyId != null && isMember(
          get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.get('adminIds', [])
        ))
      ));
      // Billing is written exclusively by Cloud Functions (Stripe/MercadoPago webhooks)
      allow write: if false;
    }

  }
}
